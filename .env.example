# LOCAL ONLY. Create .env with random unique secrets; never commit it.
IAM_DB_PASSWORD=
IDENTITY_DB_PASSWORD=
IAM_ADMIN_USERNAME=
IAM_ADMIN_PASSWORD=
# Optional locally; required as an immutable digest in staged/production Compose.
IAM_IMAGE=accesslobby-iam:local
# Account lifecycle switches. Keep verification/reset false until SMTP is configured and tested.
PUBLIC_REGISTRATION_ENABLED=false
IAM_VERIFY_EMAIL=false
IAM_RESET_PASSWORD_ENABLED=false
WEB_BASE_URL=http://localhost:3000
API_PUBLIC_ORIGIN=http://localhost:3001
OIDC_ISSUER=http://localhost:8080/realms/accesslobby-first-party
OIDC_CLIENT_ID=accesslobby-web
OIDC_API_AUDIENCE=accesslobby-api
ALLOWED_CLIENT_IDS=accesslobby-web
DATABASE_URL=postgres://accesslobby:REPLACE@localhost:5433/accesslobby
API_INTERNAL_URL=http://localhost:3001
# 32 random bytes, base64url: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
