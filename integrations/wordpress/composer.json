{
  "name": "accesslobby/wordpress-sso",
  "description": "AccessLobby standalone first-party WordPress connector",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {"php": ">=8.3", "ext-openssl": "*", "ext-sodium": "*", "firebase/php-jwt": "^7.0"},
  "require-dev": {"phpunit/phpunit": "^11.5", "phpstan/phpstan": "^2.1", "php-stubs/wordpress-stubs": "^6.9 || ^7.0", "wp-coding-standards/wpcs": "^3.2", "squizlabs/php_codesniffer": "^3.13"},
  "config": {"sort-packages": true, "allow-plugins": false},
  "scripts": {"test": "phpunit", "analyze": "phpstan analyse --memory-limit=512M", "prefix": "python3 scripts/prefix-jwt.py"}
}
